# Required: signs session cookies. Generate with `openssl rand -base64 48`.
# Changing it signs everyone out.
SESSION_SECRET=

# Port on the host.
SHELFPLAN_PORT=8000

# 0 for plain http on localhost, 1 when served over TLS. Never 0 on the internet.
COOKIE_SECURE=0

# --- public deployment ----------------------------------------------------
# Set to your https origin once deployed. Turns on HSTS and http->https
# redirects, and makes the app warn if COOKIE_SECURE is still off.
PUBLIC_URL=

# Your domain and contact address, for the Caddy/VPS deploy only.
DOMAIN=
EMAIL=

# Who may create an account: open | invite | closed.
# "invite" is the default -- anyone with the link still needs the code.
SIGNUP_MODE=invite
SIGNUP_INVITE_CODE=

# Rate limits (per rolling window). Defaults are sensible; raise if too tight.
# RATE_LOGIN_PER_IP=20        # per 15 min
# RATE_LOGIN_PER_ACCOUNT=8    # per 15 min
# RATE_REGISTER_PER_IP=5      # per hour
# RATE_REFRESH_PER_USER=12    # per hour -- price lookups leave YOUR server IP

# SQLite by default. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/shelfplan
DATABASE_URL=sqlite:////app/data/shelfplan.db

# Optional. Only needed for Coles lookups; Woolworths needs no key.
COLES_API_KEY=
