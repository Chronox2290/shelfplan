# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.env
# Runtime data. The database holds accounts and Argon2 password hashes, so it
# must never reach a repository -- public or private.
data/
backups/
*.db
*.sqlite
*.sqlite3

# Local state
.launcher-seen
coles_key.txt

# Personal meal plans exported from the app. These are the user's own data,
# not part of the project.
shelf-plan*.html
*-plan-updated.html

# Scratch output from development probes
catalog_probe.json
resolve_probe.json
resolve2.json

# TLS material. `tailscale cert` writes a private key into the working
# directory, and a key in a public repository is unrecoverable once pushed.
*.key
*.crt
*.pem
*.p12
*.keystore
# The Android build: keep the config so a rebuild is reproducible, but never
# the signing key or the build output. Losing the keystore means a later build
# can only replace the app, never update it -- so back it up somewhere safe,
# just not here.
android/*
!android/twa-manifest.json
